# Secrets: the key only ever reaches the process via `op run --env-file=.env.tpl`.
.env
.env.*
!.env.tpl
# Wrangler's local secrets file. The key never goes in a file (docs/plan.md, Phase 7).
.dev.vars
.dev.vars*

# Audit and call logs (may hold ticket text; never committed)
logs/
*.jsonl
# ...except the eval ticket set, which is synthetic and versioned
!evals/**/*.jsonl

# Downloaded model weights (pinned and hash-checked in retrieval.py)
.cache/

# Node (web/)
node_modules/
.wrangler/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# OS / editors
.DS_Store
.idea/
.vscode/
