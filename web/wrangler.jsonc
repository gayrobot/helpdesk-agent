// The public site (Phase 9, tiers 1 and 2), deployed from this machine for now; Phase 10
// moves deploys to GitHub Actions.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "helpdesk-agent",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  // nodejs_compat fills process.env from bindings, so the Anthropic SDK reads the key
  // itself and no code here ever handles it.
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  // Locally the key comes only from the environment that `op run` sets: wrangler reads a
  // required secret from process.env. Never put it in .dev.vars or any other file.
  // Secrets: the API key; MODEL_CALLS ("on" enables model calls, anything else or unset
  // means off); the Turnstile widget's secret and site key (the site key isn't sensitive,
  // it's set the same way so the widget can be created after the Worker exists); the
  // salt for hashing visitor IPs.
  "secrets": {
    "required": [
      "ANTHROPIC_API_KEY",
      "MODEL_CALLS",
      "TURNSTILE_SECRET",
      "TURNSTILE_SITEKEY",
      "VISITOR_SALT"
    ]
  },
  "dev": { "ip": "127.0.0.1" },
  // The page. Only /api/* runs the Worker; everything else is a static file or a 404.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },
  // One Durable Object per visitor session (src/worker/session-object.ts).
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "HelpdeskSession" },
      { "name": "BUDGET", "class_name": "Budget" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HelpdeskSession", "Budget"] }],
  // The public site (Phase 9, tiers 1 and 2). Deployed from this machine by Claude Code
  // with Skylar's local wrangler login (allowed 2026-11-26).
  "routes": [{ "pattern": "hddemo.damiano.dev", "custom_domain": true }],
  // BUDGET_DAILY_USD: the site's daily dollar cap (tiers 1 and 2 together), raised from
  // the code default of $2 by Skylar's decision on 2026-11-27.
  "vars": { "SITE_HOSTNAME": "hddemo.damiano.dev", "BUDGET_DAILY_USD": "5" }
}
