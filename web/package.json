{
  "name": "helpdesk-agent-web",
  "version": "0.0.0",
  "private": true,
  "description": "Phase 7: the helpdesk agent in TypeScript for Cloudflare Workers. Synthetic data only.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test",
    "eval-retrieval": "node src/node/eval-retrieval.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0"
  }
}
