// Test build only (scripted model, no key): test/worker-session.test.ts. Never deployed.
{
  "name": "helpdesk-agent-test",
  "main": "entry.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "HelpdeskSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HelpdeskSession"] }]
}
